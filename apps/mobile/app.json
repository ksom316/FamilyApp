{
  "expo": {
    "name": "FamilyApp",
    "slug": "familyapp",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "familyapp",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/familyapp-app-icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "defaultChannel": "familyapp-default",
          "color": "#0B1F5B"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.familyapp.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/familyapp-adaptive-icon.png",
        "backgroundColor": "#0B1F5B"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ec396353-4ca7-46fc-87f2-befd638cdf71"
      }
    },
    "owner": "ksom316"
  }
}
