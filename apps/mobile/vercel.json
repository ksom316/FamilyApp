{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "corepack pnpm build:web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://familyapp-api.ksom316.workers.dev/api/:path*"
    },
    {
      "source": "/families",
      "destination": "https://familyapp-api.ksom316.workers.dev/families"
    },
    {
      "source": "/families/:path*",
      "destination": "https://familyapp-api.ksom316.workers.dev/families/:path*"
    },
    {
      "source": "/me",
      "destination": "https://familyapp-api.ksom316.workers.dev/me"
    },
    {
      "source": "/me/:path*",
      "destination": "https://familyapp-api.ksom316.workers.dev/me/:path*"
    },
    {
      "source": "/health",
      "destination": "https://familyapp-api.ksom316.workers.dev/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
